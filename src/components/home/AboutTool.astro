---
// Long-form explanation of the tool for readers (and search engines) who want
// the detail: what it is, how to use it, formats, exports, languages, privacy.
import { defaultLocale, type Locale } from '../../i18n/config';
import { useTranslations, localizeHtml } from '../../i18n/ui';

interface Props {
  lang?: Locale;
}
const { lang = defaultLocale } = Astro.props;
const a = useTranslations(lang).home.about;
---
<section class="about" aria-labelledby="about-h">
  <div class="container-wide grid">
    <div class="side">
      <p class="eyebrow">{a.eyebrow}</p>
      <h2 id="about-h" class="h-section">{a.title}</h2>
      <p class="lede">{a.lede}</p>
      <nav class="toc" aria-label={a.toc}>
        <p class="eyebrow">{a.toc}</p>
        <ol>
          {a.sections.map((x) => <li><a href={`#${x.id}`}>{x.label}</a></li>)}
        </ol>
      </nav>
    </div>

    <article class="prose body">
      {a.sections.map((x) => (
        <Fragment>
          <h3 id={x.id}>{x.heading}</h3>
          <Fragment set:html={localizeHtml(x.html, lang)} />
        </Fragment>
      ))}
    </article>
  </div>
</section>

<style>
  .about {
    padding: 128px 0 0;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
    gap: 64px;
    align-items: start;
  }
  .side {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    display: grid;
    gap: 14px;
  }
  .side .lede {
    max-width: 44ch;
  }
  .toc {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 10px;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0 12px;
    border-left: 1px solid var(--rule);
    display: grid;
    gap: 8px;
    font-size: var(--t-sm);
  }
  .toc a {
    color: var(--ink-3);
    text-decoration: none;
    transition: color 150ms var(--ease);
  }
  .toc a:hover {
    color: var(--ink);
  }
  .body {
    max-width: 72ch;
    font-size: var(--t-md);
  }
  .body h3 {
    font-size: var(--t-xl);
    letter-spacing: var(--track-sub);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .body h3:first-child {
    margin-top: 0;
  }
  .body ol li::marker {
    font-family: var(--mono);
    font-size: var(--t-sm);
    color: var(--ink-3);
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .side {
      position: static;
    }
  }
  @media (max-width: 760px) {
    .about {
      padding-top: 96px;
    }
  }
</style>
