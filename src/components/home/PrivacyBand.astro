---
import { serverConfig } from '../../lib/server/config';
import { defaultLocale, localizePath, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang?: Locale;
}
const { lang = defaultLocale } = Astro.props;
const p = useTranslations(lang).home.privacy;
const enhanced = serverConfig.enhancedEnabled;
---
<section class="priv" aria-labelledby="priv-h">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">{p.eyebrow}</p>
      <h2 id="priv-h" class="h-section">{p.title}</h2>
      <p class="lede">{p.lede}</p>
      <a class="btn btn-pill more" href={localizePath('/privacy', lang)}>{p.more}</a>
    </div>
    <ul class="facts">
      <li>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4M7.5 8.5 12 4l4.5 4.5M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 4l16 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <strong>{p.uploadTitle}</strong> {p.uploadText}
      </li>
      <li>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <strong>{p.keptTitle}</strong> {p.keptText}
      </li>
      <li>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l2-5 4 10 2-5h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <strong>{p.checkTitle}</strong> {p.checkText}
      </li>
      {enhanced && (
        <li>
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18a4 4 0 0 1-.5-8A6 6 0 0 1 18 9a4.5 4.5 0 0 1-.5 9z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          <strong>{p.cloudTitle}</strong> {p.cloudText}
        </li>
      )}
    </ul>
  </div>
</section>

<style>
  /* Always an ink band, in both themes. */
  .priv {
    --band: #0a0a0a;
    --band-ink: #ededed;
    --band-mute: #a1a1a1;
    --band-rule: rgb(255 255 255 / 0.1);
    margin-top: 128px;
    padding: 96px 0;
    background: var(--band);
    color: var(--band-ink);
    border-block: 1px solid var(--band-rule);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .priv {
      --band: #000;
    }
  }
  :global(:root[data-theme='dark']) .priv {
    --band: #000;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 64px;
    align-items: start;
  }
  .copy {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .eyebrow {
    color: var(--band-mute);
  }
  .lede {
    color: var(--band-mute);
    max-width: 50ch;
  }
  .more {
    margin-top: 10px;
    --btn-bg: transparent;
    --btn-fg: var(--band-ink);
    --btn-bd: rgb(255 255 255 / 0.2);
    box-shadow: none;
  }
  .more:hover {
    --btn-bg: rgb(255 255 255 / 0.08);
  }
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--band-rule);
    border: 1px solid var(--band-rule);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .facts li {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 24px;
    background: var(--band);
    color: var(--band-mute);
    font-size: var(--t-sm);
    line-height: 1.65;
  }
  .facts li:only-child,
  .facts li:nth-child(3):last-child {
    grid-column: 1 / -1;
  }
  .facts svg {
    color: var(--band-ink);
    margin-bottom: 10px;
  }
  .facts strong {
    display: block;
    color: var(--band-ink);
    font-weight: 500;
    font-size: var(--t-md);
  }
  .priv :global(:focus-visible) {
    outline-color: #3291ff;
  }
  @media (max-width: 860px) {
    .priv {
      margin-top: 96px;
      padding: 72px 0;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
