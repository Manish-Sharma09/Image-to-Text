---
import ShareView from '../../views/ShareView.astro';
import { defaultLocale, type Locale } from '../../i18n/config';
import { siteLocales } from '../../i18n/ui';

export function getStaticPaths() {
  return siteLocales.filter((l) => l !== defaultLocale).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
---
<ShareView {lang} />
