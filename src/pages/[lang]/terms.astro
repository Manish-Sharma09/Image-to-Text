---
import TermsView from '../../views/TermsView.astro';
import { defaultLocale, type Locale } from '../../i18n/config';
import { siteLocales } from '../../i18n/ui';
import { hasLegal } from '../../i18n/legal';

// Only locales with a translation of the terms get their own page.
export function getStaticPaths() {
  return siteLocales.filter((l) => l !== defaultLocale && hasLegal(l)).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
---
<TermsView {lang} />
