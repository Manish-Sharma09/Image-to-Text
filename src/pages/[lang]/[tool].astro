---
import ToolView from '../../views/ToolView.astro';
import { defaultLocale } from '../../i18n/config';
import { siteLocales } from '../../i18n/ui';
import { listTranslated } from '../../i18n/content';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of siteLocales.filter((l) => l !== defaultLocale)) {
    for (const item of await listTranslated('tools', lang)) paths.push({ params: { lang, tool: item.slug }, props: { lang, item } });
  }
  return paths;
}
const { lang, item } = Astro.props;
---
<ToolView {lang} {item} />
