---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ToolHero from '../components/site/ToolHero.astro';
import Faq from '../components/site/Faq.astro';
import RelatedTools from '../components/site/RelatedTools.astro';
import { SITE } from '../config/site';
import { languages, localizePath, type Locale } from '../i18n/config';
import { useTranslations, siteLocales } from '../i18n/ui';
import { localesOf, type Localized } from '../i18n/content';

interface Props {
  lang: Locale;
  item: Localized<'tools'>;
}
const { lang, item } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(item.entry);
const d = item.entry.data;
const site = Astro.site ?? new URL(SITE.url);
const url = new URL(localizePath(`/${item.slug}`, lang), site).href;
const alternates = (await localesOf('tools', item.slug)).filter((l) => siteLocales.includes(l));

const schema = [
  {
    '@type': 'WebApplication',
    name: `${d.navLabel} — ${SITE.name}`,
    url,
    inLanguage: languages[lang].hreflang,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: t.schema.operatingSystem,
    browserRequirements: t.schema.browserRequirements,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: d.description,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.hero.crumbHome, item: new URL(localizePath('/', lang), site).href },
      { '@type': 'ListItem', position: 2, name: d.navLabel, item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    inLanguage: languages[lang].hreflang,
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={d.title} description={d.description} schema={schema} hasWorkspace {lang} {alternates}>
  <ToolHero h1={d.h1} intro={d.intro} mode={d.preset.mode} exportFormat={d.preset.export} sample={d.preset.sample} camera={d.preset.camera} crumb={d.navLabel} {lang} />

  <div class="container below">
    <section class="steps" aria-labelledby="steps-h">
      <h2 id="steps-h">{t.tool.howToUse}</h2>
      <div class="frame">
        <ol>
          {d.steps.map((s, i) => (
            <li>
              <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span>{s}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <article class="prose body">
      <Content />
    </article>

    <Faq items={d.faq} heading={t.tool.faqHeading} />
    <RelatedTools slugs={d.related} heading={t.tool.relatedHeading} {lang} />
  </div>
</Base>

<style>
  .below {
    display: grid;
    gap: 96px;
    margin-top: 96px;
  }
  .steps h2 {
    font-size: clamp(var(--t-2xl), 2.6vw, var(--t-3xl));
    letter-spacing: var(--track-heading);
    margin-bottom: 24px;
  }
  /* Shared-hairline grid: the list overhangs the frame by 1px on the right
     and bottom so the outer cells' borders are clipped by the frame. */
  .frame {
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    background: var(--sheet);
    overflow: hidden;
  }
  .steps ol {
    list-style: none;
    margin: 0 -1px -1px 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .steps li {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 24px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    color: var(--ink-2);
    line-height: 1.6;
  }
  .body > :global(:first-child) {
    margin-top: 0;
  }
  .n {
    font-family: var(--mono);
    font-size: var(--t-xs);
    font-weight: 500;
    line-height: 16px;
    color: var(--ink-3);
  }
  @media (max-width: 640px) {
    .below {
      gap: 64px;
      margin-top: 64px;
    }
    .steps li {
      padding: 20px;
    }
  }
</style>
