---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/site/Crumbs.astro';
import { SITE } from '../config/site';
import { LANGUAGES } from '../lib/ocr/languages';
import { pageSchema } from '../lib/schema';
import { fmt, localizePath, type Locale } from '../i18n/config';
import { useTranslations, siteLocales, localizeHtml } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.aboutPage;
const site = Astro.site ?? new URL(SITE.url);
const title = t.meta.aboutTitle;
const description = fmt(t.meta.aboutDescription, { site: SITE.name });

const facts = [
  { value: LANGUAGES.length, label: p.factLanguages },
  { value: SITE.maxPages, label: p.factPages },
  // TXT, Word, PDF, searchable PDF, Excel, CSV, Markdown, HTML, JSON (lib/export/formats.ts, ZIP aside).
  { value: 9, label: p.factFormats },
  { value: 0, label: p.factSignups },
];

const icons = [
  'M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6l7-3Zm-3 9 2 2 4-4',
  'M20 12v8H4v-8M2 7h20v5H2V7Zm10 15V7m0 0H7.5a2.5 2.5 0 1 1 0-5C11 2 12 7 12 7Zm0 0h4.5a2.5 2.5 0 1 0 0-5C13 2 12 7 12 7Z',
  'M4 7h10M4 12h16M4 17h7m3 0c1-1.3 2-1.3 3 0s2 1.3 3 0',
  'M3 4h18v16H3V4Zm0 6h18M3 15h18M9 4v16',
];

const credits = [
  { id: 'tesseract', name: 'Tesseract', href: 'https://github.com/tesseract-ocr/tesseract', license: 'Apache-2.0' },
  { id: 'tesseractjs', name: 'Tesseract.js', href: 'https://github.com/naptha/tesseract.js', license: 'Apache-2.0' },
  { id: 'pdfjs', name: 'PDF.js', href: 'https://mozilla.github.io/pdf.js/', license: 'Apache-2.0' },
  { id: 'libheif', name: 'libheif', href: 'https://github.com/strukturag/libheif', license: 'LGPL-3.0' },
  { id: 'codemirror', name: 'CodeMirror', href: 'https://codemirror.net', license: 'MIT' },
  { id: 'utif', name: 'UTIF.js', href: 'https://github.com/photopea/UTIF.js', license: 'MIT' },
  { id: 'fflate', name: 'fflate', href: 'https://github.com/101arrowz/fflate', license: 'MIT' },
  { id: 'svelte', name: 'Svelte', href: 'https://svelte.dev', license: 'MIT' },
  { id: 'astro', name: 'Astro', href: 'https://astro.build', license: 'MIT' },
  { id: 'geist', name: 'Geist', href: 'https://vercel.com/font', license: 'OFL-1.1' },
] as const;

const schema = pageSchema({ type: 'AboutPage', path: '/about', name: p.eyebrow, description, lang, site, homeName: t.hero.crumbHome });
---
<Base {title} {description} {schema} {lang} alternates={siteLocales}>
  <div class="container page">
    <header class="head">
      <Crumbs {lang} current={p.eyebrow} />
      <h1 class="h-display">{p.title}</h1>
      <p class="lede">{fmt(p.lede, { site: SITE.name })}</p>
    </header>

    <section class="facts" aria-labelledby="facts-h">
      <h2 id="facts-h" class="visually-hidden">{p.factsTitle}</h2>
      <dl>
        {facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="split" aria-labelledby="why-h">
      <h2 id="why-h" class="h-section">{p.whyTitle}</h2>
      <div class="prose" set:html={fmt(localizeHtml(p.whyHtml, lang), { site: SITE.name })} />
    </section>

    <section aria-labelledby="principles-h">
      <h2 id="principles-h" class="h-section">{p.principlesTitle}</h2>
      <ul class="cards">
        {p.principles.map((x, i) => (
          <li>
            <span class="icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24"><path d={icons[i % icons.length]} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <h3>{x.title}</h3>
            <p>{fmt(x.text, { pages: SITE.maxPages, mb: SITE.maxFileMB })}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="split" aria-labelledby="how-h">
      <h2 id="how-h" class="h-section">{p.howTitle}</h2>
      <div class="prose" set:html={localizeHtml(p.howHtml, lang)} />
    </section>

    <section aria-labelledby="credits-h">
      <div class="credits-head">
        <h2 id="credits-h" class="h-section">{p.creditsTitle}</h2>
        <p>{p.creditsText}</p>
      </div>
      <div class="frame">
        <ul class="credits">
          {credits.map((c) => (
            <li>
              <a href={c.href} rel="noopener" translate="no">
                <strong>{c.name}</strong>
                <span class="role" translate="yes">{p.creditRoles[c.id]}</span>
                <span class="lic">{c.license}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="cta" aria-labelledby="cta-h">
      <h2 id="cta-h" class="h-section">{p.ctaTitle}</h2>
      <p class="lede">{p.ctaText}</p>
      <div class="actions">
        <a class="btn btn-primary btn-lg btn-pill" href={localizePath('/contact', lang)}>{p.ctaContact}</a>
        <a class="btn btn-lg btn-pill" href={localizePath('/', lang)}>{p.ctaTool}</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .page {
    padding-top: 64px;
    display: grid;
    gap: 96px;
  }
  .head {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  h1 {
    max-width: 18ch;
  }
  .head .lede {
    max-width: 62ch;
    font-size: var(--t-xl);
    line-height: 1.55;
  }

  /* Facts: shared-hairline tiles, the number above its label. */
  .facts {
    margin-top: -32px;
  }
  .facts dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    background: var(--sheet);
    overflow: hidden;
  }
  .facts div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
    padding: 28px;
  }
  .facts div + div {
    border-left: 1px solid var(--rule);
  }
  .facts dd {
    margin: 0;
    font-size: clamp(2.25rem, 4vw, var(--t-4xl));
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--track-display);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .facts dt {
    font-size: var(--t-sm);
    color: var(--ink-3);
    line-height: 1.45;
  }

  /* Heading on the left, text on the right. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 48px;
    align-items: start;
  }
  .split .prose {
    max-width: 62ch;
  }
  .split .prose > :global(:first-child) {
    margin-top: 0;
  }
  .split .prose :global(ol) {
    padding-left: 1.4em;
  }
  .split .prose :global(ol li::marker) {
    font-family: var(--mono);
    font-size: var(--t-sm);
  }

  .cards {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .cards li {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 28px;
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 8px;
    border-radius: var(--r-md);
    background: var(--well);
    border: 1px solid var(--rule);
    color: var(--ink);
  }
  .cards h3 {
    font-size: var(--t-xl);
    letter-spacing: var(--track-sub);
  }
  .cards p {
    color: var(--ink-2);
    line-height: 1.6;
    max-width: 52ch;
  }

  .credits-head {
    display: grid;
    gap: 12px;
    margin-bottom: 24px;
  }
  .credits-head p {
    color: var(--ink-2);
    max-width: 60ch;
  }
  /* Shared-hairline grid: the list overhangs the frame by 1px on the right
     and bottom so the outer cells' borders are clipped by the frame. */
  .frame {
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    background: var(--sheet);
    overflow: hidden;
  }
  .credits {
    list-style: none;
    padding: 0;
    margin: 0 -1px -1px 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  }
  .credits li {
    display: flex;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .credits a {
    flex: 1;
    display: grid;
    gap: 2px;
    padding: 20px 24px;
    text-decoration: none;
    color: var(--ink);
    transition: background-color 150ms var(--ease);
  }
  .credits a:hover {
    background: var(--paper);
  }
  .credits a:focus-visible {
    outline-offset: -2px;
  }
  .credits strong {
    font-weight: 500;
  }
  .role {
    font-size: var(--t-sm);
    color: var(--ink-3);
  }
  .lic {
    margin-top: 6px;
    font-family: var(--mono);
    font-size: var(--t-xs);
    color: var(--ink-4);
  }

  .cta {
    display: grid;
    justify-items: center;
    gap: 12px;
    text-align: center;
    padding: 64px 32px;
    border: 1px solid var(--rule);
    border-radius: var(--r-xl);
    background: var(--sheet);
    box-shadow: var(--shadow-2);
  }
  .cta h2 {
    max-width: 22ch;
  }
  .actions {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .facts dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .facts div:nth-child(3) {
      border-left: 0;
    }
    .facts div:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }
  @media (max-width: 640px) {
    .page {
      padding-top: 40px;
      gap: 72px;
    }
    .facts {
      margin-top: -24px;
    }
    .facts div {
      padding: 20px;
    }
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .cards li {
      padding: 22px;
    }
    .cta {
      padding: 40px 20px;
    }
  }
</style>
