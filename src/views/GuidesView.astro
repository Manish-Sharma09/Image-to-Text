---
import Base from '../layouts/Base.astro';
import { localizePath, plural, type Locale } from '../i18n/config';
import { useTranslations, siteLocales } from '../i18n/ui';
import { listLocalized } from '../i18n/content';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.guidesPage;
const guides = await listLocalized('guides', lang);
---
<Base title={t.meta.guidesTitle} description={t.meta.guidesDescription} {lang} alternates={siteLocales}>
  <div class="container page">
    <header>
      <p class="eyebrow">{plural(lang, guides.length, p.count)}</p>
      <h1 class="h-display">{p.title}</h1>
      <p class="lede">{p.lede}</p>
    </header>
    <div class="frame">
      <ol class="list">
        {guides.map((g) => (
          <li>
            <a href={localizePath(`/guides/${g.slug}`, g.lang)}>
              <h2>
                {g.entry.data.title}
                <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </h2>
              <p>{g.entry.data.summary}</p>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Base>

<style>
  .page {
    padding-top: 64px;
  }
  header {
    display: grid;
    gap: 16px;
    justify-items: start;
    margin-bottom: 48px;
  }
  header .lede {
    max-width: 60ch;
  }
  /* Shared-hairline grid: the list overhangs the frame by 1px on the right
     and bottom so the outer cells' borders are clipped by the frame. */
  .frame {
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    background: var(--sheet);
    overflow: hidden;
  }
  .list {
    list-style: none;
    margin: 0 -1px -1px 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  li {
    display: flex;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .frame a {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 28px;
    text-decoration: none;
    transition: background-color 150ms var(--ease);
  }
  .frame a:hover {
    background: var(--paper);
  }
  .frame a:focus-visible {
    outline-offset: -2px;
  }
  h2 {
    font-size: var(--t-xl);
    line-height: 1.3;
    letter-spacing: var(--track-sub);
    color: var(--ink);
  }
  .arr {
    display: inline-block;
    vertical-align: -2px;
    margin-left: 2px;
    color: var(--ink-4);
    transition: transform 200ms var(--ease-out), color 150ms var(--ease);
  }
  .frame a:hover .arr {
    color: var(--ink);
    transform: translateX(2px);
  }
  .frame a p {
    color: var(--ink-3);
    font-size: var(--t-sm);
    line-height: 1.6;
    max-width: 60ch;
  }
  @media (max-width: 760px) {
    .list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .page {
      padding-top: 40px;
    }
    header {
      margin-bottom: 32px;
    }
    .frame a {
      padding: 20px;
    }
  }
</style>
