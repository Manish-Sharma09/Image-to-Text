---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/site/Crumbs.astro';
import LegalDoc from '../components/site/LegalDoc.astro';
import { SITE } from '../config/site';
import { pageSchema } from '../lib/schema';
import { defaultLocale, fmt, languages, localizePath, type Locale } from '../i18n/config';
import { useTranslations, siteLocales } from '../i18n/ui';
import { useLegal, hasLegal } from '../i18n/legal';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const doc = useLegal(lang).terms;
const site = Astro.site ?? new URL(SITE.url);
const vars = { site: SITE.name, operator: SITE.operator, email: SITE.email, url: site.host };
const description = fmt(t.meta.termsDescription, { site: SITE.name });
const updated = new Date(`${SITE.legalUpdated}T00:00:00Z`);
const date = new Intl.DateTimeFormat(languages[lang].hreflang, { dateStyle: 'long', timeZone: 'UTC' });
const schema = pageSchema({ type: 'WebPage', path: '/terms', name: doc.title, description, lang, site, homeName: t.hero.crumbHome, modified: SITE.legalUpdated });
---
<Base title={t.meta.termsTitle} {description} {schema} {lang} alternates={siteLocales.filter(hasLegal)}>
  <div class="container page">
    <header class="head">
      <Crumbs {lang} current={doc.title} />
      <h1 class="h-display">{doc.title}</h1>
      <p class="lede">{fmt(doc.lede, vars)}</p>
      <p class="eyebrow">{t.legalPage.updated} <time datetime={SITE.legalUpdated}>{date.format(updated)}</time></p>
      {lang !== defaultLocale && <p class="note" set:html={fmt(t.legalPage.translationNoteHtml, { href: localizePath('/terms', defaultLocale) })} />}
    </header>
    <LegalDoc sections={doc.sections} {lang} {vars} />
  </div>
</Base>

<style>
  .page {
    padding-top: 64px;
    display: grid;
    gap: 64px;
  }
  .head {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--rule);
  }
  .head .lede {
    max-width: 60ch;
    font-size: var(--t-xl);
    line-height: 1.55;
  }
  .note {
    max-width: 70ch;
    font-size: var(--t-sm);
    color: var(--ink-3);
  }
  .note :global(a) {
    color: var(--accent);
    text-decoration: none;
  }
  .note :global(a:hover) {
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .page {
      padding-top: 40px;
      gap: 40px;
    }
    .head {
      padding-bottom: 32px;
    }
  }
</style>
