# Public URL used for canonical links and the sitemap.
SITE_URL=https://imagetotextapp.com
# Shown on the Contact, Privacy and Terms pages and in structured data.
CONTACT_EMAIL=hello@imagetotextapp.com
# Legal name of the person or company that runs the site (Privacy and Terms).
LEGAL_NAME=

# Optional: enables "Enhanced" OCR (handwriting, math, complex tables) through a
# server-side call to Anthropic's API. Leave empty to run fully on-device.
ANTHROPIC_API_KEY=
# Optional model override for Enhanced OCR.
ENHANCED_OCR_MODEL=claude-opus-5-5
# Enhanced OCR requests allowed per visitor IP per day.
ENHANCED_OCR_DAILY_LIMIT=20
